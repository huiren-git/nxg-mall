<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nxg.mall.analytics.mapper.CustomerStatDailyMapper">

    <select id="selectTrend" resultType="map">
        SELECT DATE_FORMAT(stat_date, '%m-%d') as day,
        <choose>
            <when test="type == 'visitors'">uv_count</when>
            <when test="type == 'newUsers'">new_user_count</when>
            <when test="type == 'recharge'">recharge_user_count</when>
            <otherwise>0</otherwise>
        </choose> as val
        FROM t_customer_stat_daily
        WHERE stat_date BETWEEN #{start} AND #{end}
        ORDER BY stat_date ASC
    </select>

</mapper>